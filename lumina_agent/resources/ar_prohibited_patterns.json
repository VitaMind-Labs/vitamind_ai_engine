  "confront_or_dispute_belief": "(?:هذا|ذلك)\\s+(?:غير حقيقي|ليس حقيقي|ليس حقيقياً|لم يحدث)|أنت\\s+(?:تتخيل|تتوهم)",
  "treatment_replacement": "(?:بدلاً|بدلا)\\s+(?:من|عن)\\s+(?:ال)?(?:علاج|دواء|طبيب)"
