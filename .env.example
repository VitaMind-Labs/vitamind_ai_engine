# VitaMind AI engine — both agents. Copy to .env and fill in.
# Never commit .env.

# ---- ports (each agent needs its own; the launcher refuses a collision) ----
MIRA_PORT=8101
LUMINA_PORT=8102
AGENT_HOST=127.0.0.1
AGENT_LOG_LEVEL=info

# ---- service-to-service auth ----
# Lumina verifies HMAC-SHA256 over timestamp.requestId.sha256(body).
# The backend must hold the same value in LUMINA_SERVICE_SECRET.
LUMINA_SERVICE_SECRET=change-me-at-least-32-bytes-long

# Local development only: run Lumina without signature verification.
# Leave false anywhere a real client can reach the port.
LUMINA_ALLOW_UNSIGNED=false

# ---- clinical content gate ----
# false => Lumina refuses to start while the intervention catalog is still
# DRAFT_NEEDS_CLINICAL_REVIEW. Set true only in development.
ALLOW_UNREVIEWED_SAFETY_CONTENT=true
